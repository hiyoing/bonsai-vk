// bench_shm_n4096.comp - occupancy bench, PROBE_N = 4096.
//
//   sd[4096] + sp[4096] = 2 * 4096 * 4 B = 32768 B of workgroup memory per 256-lane workgroup.
//   Same instruction stream as the other bench sizes; only this declaration differs.
#version 450
#extension GL_GOOGLE_include_directive : require
#define PROBE_N 4096u
#include "shared_mem_bench.glslh"
