#version 450

// math_probe.comp - what do this card's built-in transcendentals actually return?
//
// align_attn's stage-1 kernel computes rope's theta with pow(), its rotation with cos()/sin(), and the
// softmax/sigmoid with exp(). The CPU mirror in attn_vk.h calls std::pow / std::cos / std::sin /
// std::exp on the same fp32 inputs. GLSL only promises "approximate" results for those builtins
// (section 8.1: "the level of support ... depends on the implementation"), while libm promises ~1 ulp,
// so the two are NOT the same function - and a 1e-5 relative difference is 0.02 of an fp16 ulp, which
// is exactly the size that decides a rounding tie. This probe measures that gap over the argument sets
// attention really uses, instead of leaving it as a rumour behind a bit-exactness failure.
//
// Every output is the fp32 result, compared BIT FOR BIT against the host call; the leg also prints the
// largest relative error, because "differs" without a magnitude is not a measurement.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer A  { float a[]; };    // pow base
layout(binding = 1) readonly  buffer B  { float b[]; };    // pow exponent
layout(binding = 2) readonly  buffer C  { float c[]; };    // cos/sin angle, exp argument
layout(binding = 3) writeonly buffer OP { float op[]; };   // pow(a,b)
layout(binding = 4) writeonly buffer OC { float oc[]; };   // cos(c)
layout(binding = 5) writeonly buffer OS { float os_[]; };  // sin(c)
layout(binding = 6) writeonly buffer OX { float ox[]; };   // exp(c)
// Two more, added because leg R found the PASS-THROUGH rope dims (d >= n_rot: no cos, no sin, no pow
// anywhere in their value) differing bit for bit from the CPU mirror. Those dims are
//     y = (x * inv) * w   with   inv = 1 / sqrt(sum(x*x)/hd + eps)
// so only three things can make them differ: the driver's sqrt, its division, or the compiler contracting
// `ss = ss + x*x` into an FMA (which changes the sum). sqrt and 1/sqrt are measured here (on abs(c), so
// the softmax's negative arguments do not turn the probe into a NaN generator); the FMA question is
// answered by the barrier-split accumulation in attn_norm_rope.comp.
layout(binding = 7) writeonly buffer OQ { float oq[]; };   // sqrt(c)
layout(binding = 8) writeonly buffer OI { float oi[]; };   // 1.0 / sqrt(c)
layout(binding = 9) writeonly buffer OD { float od[]; };   // 1.0 / c

layout(push_constant) uniform Push {
    uint n;                     // indices to evaluate
    uint pad0, pad1, pad2;
} p;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    op[i]  = pow(a[i], b[i]);
    oc[i]  = cos(c[i]);
    os_[i] = sin(c[i]);
    ox[i]  = exp(c[i]);
    oq[i]  = sqrt(abs(c[i]));
    oi[i]  = 1.0 / sqrt(abs(c[i]));
    od[i]  = 1.0 / c[i];
}
