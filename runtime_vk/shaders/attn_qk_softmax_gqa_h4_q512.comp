// attn_qk_softmax_gqa_h4_q512.comp - GQA-merged stage-2 kernel, HPK = n_head/n_head_kv = 4, 512 keys
// per tile. THIS IS THE DEFAULT MERGED WIDTH.
//
//   LDS = HPK*4*QTILE + 8*HPK = 4*4*512 + 32 = 8,224 B = 8.03 KiB per workgroup.
//   Why 512 and not 2048 like the tiled kernel: the merge multiplies the row count inside one workgroup
//   by HPK, so the same LDS budget buys QTILE/HPK keys per tile. The measured flat band on this card is
//   4-16 KiB (0.13% spread at 16384 positions, runs/kvfx_c16384_q*_v1.log), the cliff starts past 16 KiB
//   (+6.6% to +10.4%), and the design line is one workgroup never crosses 16 KiB.
//   The `h4` in the name is load-bearing - HPK is a compile-time constant and fwd_init selects this
//   module only for a plan whose n_head/n_head_kv is exactly 4.
#version 450
#extension GL_GOOGLE_include_directive : require
#include "f16_rne.glslh"
#define HPK    4u
#define QTILE  512u
#include "attn_qk_softmax_gqa.glslh"
